# Public (safe for the browser) - Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# SERVER ONLY - never expose. Supabase > Project Settings > API Keys > Secret key.
# Used by /api/admin/users to create, delete and reset team accounts.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
